# Copy to .env (optional). Pre-Ampere presets apply automatically when CUDA device 0 has CC < 8.0.
# Ampere or newer — uncomment for bf16-oriented defaults without CC detection:
# ECHO_PRE_AMPERE=0

# PyTorch for NVIDIA Volta (V100) must be CUDA 12.6 wheels (pip install-time, not this file):
#   pip install --index-url https://download.pytorch.org/whl/cu126 -r requirements-torch.txt
# The Docker image sets ECHO_PYTORCH_PIP_INDEX=cu126 as a label for which wheel line was used.
